{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "absolemjackdaw.scryers.fabric.ScryersFabric"
    ],
    "client": [
      "absolemjackdaw.scryers.fabric.client.ScryersFabricClient"
    ],
    "cardinal-components": [
      "absolemjackdaw.scryers.fabric.init.ScryersComponents"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "custom": {
    "cardinal-components": [
      "scryers:scry_data"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "cardinal-components-entity": "*",
    "commonnetworking": ">=${common_networking_version}",
    "sparkweave": ">=${sparkweave_version}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
